#!/bin/sh
# Refuse to commit local paths or the invoking username.
# Three separate leaks reached public history before this existed:
# a hardcoded QEMU path, an objdump build-path header, and dejagnu .sum files.
# Generated artifacts are the usual culprit -- they embed paths you never typed.
if git diff --cached -U0 | grep -nE '^\+.*(/Users/[a-z]|/private/tmp/claude|sprice5)' ; then
    echo "pre-commit: local path or username in staged content (above)." >&2
    echo "Scrub it, or use --no-verify if it is genuinely intended." >&2
    exit 1
fi
