#!/bin/sh
# Refuse to commit local paths or the invoking username.
# Three separate leaks reached public history before this existed: a
# hardcoded QEMU path, an objdump build-path header, and dejagnu .sum
# files.  Every one came from a *generated* artifact -- they embed paths
# nobody typed, so auditing the files you were thinking about misses them.
me=$(id -un)
if git diff --cached -U0 | grep -nE "^\+.*(/Users/[a-z]|/home/[a-z]|/private/tmp/claude|${me})"; then
    echo "pre-commit: local path or username in staged content (above)." >&2
    echo "Scrub it, or pass --no-verify if it is genuinely intended." >&2
    exit 1
fi
