#!/bin/sh
# mb-qemu-run <program.elf> -- run a bare-metal test under QEMU system
# emulation and exit with the guest's own status, so DejaGnu can treat it like
# any other simulator.
#
#   MB_QEMU    path to qemu-system-microblaze or -microblazeel   (required)
#   MB_TIMEOUT seconds before declaring a hang                   (default 60)
#
# QEMU cannot hand a guest exit status back to the shell, so the runtime prints
# "*** EXIT n ***" and this reads it.  Nothing is required of the machine model
# beyond a working UART: QEMU is stopped from out here once the marker appears,
# rather than the guest writing to some shutdown device.  That keeps this
# working on stock upstream QEMU -- the petalogix-s3adsp1800 machine has no
# shutdown device, and depending on a downstream one would make this useless to
# anybody else.
#
# A guest that never prints a marker has hung: that exits 99, which DejaGnu
# reports as a failure.
: "${MB_QEMU:?set MB_QEMU to the qemu-system-microblaze[el] binary}"
prog=$1
[ -n "$prog" ] || { echo "usage: mb-qemu-run <program.elf>" >&2; exit 2; }
[ -f "$prog" ] || { echo "mb-qemu-run: no such file: $prog" >&2; exit 2; }

log=$(mktemp "${TMPDIR:-/tmp}/mb-qemu.XXXXXX") || exit 2
trap 'rm -f "$log"' EXIT

"$MB_QEMU" -M petalogix-s3adsp1800 -nographic -icount 0 \
           -kernel "$prog" > "$log" 2>/dev/null &
qpid=$!

limit=$(( ${MB_TIMEOUT:-60} * 10 ))
i=0
while [ "$i" -lt "$limit" ]; do
    grep -q '^\*\*\* EXIT ' "$log" 2>/dev/null && break
    kill -0 "$qpid" 2>/dev/null || break
    sleep 0.1
    i=$((i + 1))
done
kill "$qpid" 2>/dev/null
wait "$qpid" 2>/dev/null

tr -d '\r' < "$log" | sed '/^\*\*\* EXIT /d'
code=$(tr -d '\r' < "$log" | sed -n 's/^\*\*\* EXIT \([0-9]*\) \*\*\*$/\1/p' | tail -1)
[ -n "$code" ] || exit 99
exit "$code"
