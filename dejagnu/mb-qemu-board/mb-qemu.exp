# DejaGnu board description: MicroBlaze bare metal under QEMU.
#
#   runtest --tool gcc --target_board=mb-qemu[/-mlittle-endian] ...
#
# Set MB_QEMU to the qemu-system-microblaze or -microblazeel binary before
# running; everything else is found relative to this file.  Add
# /-mlittle-endian as a multilib option for microblazeel and point MB_QEMU at
# the matching QEMU.
#
# Why a board file rather than a shell loop: DejaGnu compiles hosted, sizes the
# stack from here, and honours dg-options and dg-require-effective-target.
# Hand-rolled runners get all four wrong -- see the repo's analysis/torture
# notes for the false failures that produced.

proc board_info_field_or_empty { dest field } {
    if { [board_info $dest exists $field] } { return [board_info $dest $field] }
    return ""
}

load_generic_config "sim"
process_multilib_options ""
# basic-sim supplies is_simulator, which DejaGnu needs to wait for the run
# correctly.  setup_sim is deliberately not called: it looks for a gdb
# simulator in a build tree, and this board is about QEMU system emulation.
# MicroBlaze does have a gdb simulator -- see ../sim-evidence/ -- but it
# implements 107 instructions, so it cannot cover hard float, mulh*, pcmp* or
# the other opt-in extensions.  That coverage is this board's whole purpose.
load_base_board_description "basic-sim"

set mb_dir [file dirname [file normalize [info script]]]

if { [info exists env(MB_QEMU)] } {
    set mb_qemu $env(MB_QEMU)
} else {
    set mb_qemu "qemu-system-microblaze"
}

# The program is run by a wrapper, not QEMU directly: QEMU cannot hand a guest
# exit status back.  The status comes out through DejaGnu's own mechanism --
# needs_status_wrapper below makes GCC link testglue.c, which wraps exit/_exit/
# abort/main and writes "*** EXIT code N"; check_for_board_status in remote.exp
# parses it.  The wrapper's job is just to stop QEMU once that line appears.
# A bare path, not a command line: DejaGnu runs the sim string through its
# "which" check, which a multi-word "env VAR=... prog" does not survive.  The
# wrapper reads MB_QEMU and MB_TIMEOUT from the environment instead.
set ::env(MB_QEMU) $mb_qemu
if { ![info exists env(MB_TIMEOUT)] } { set ::env(MB_TIMEOUT) 90 }
set_board_info sim "$mb_dir/mb-qemu-run"
set_board_info sim_time_limit 120

# The compiler DejaGnu uses to build for this board.  For the tests themselves
# this is irrelevant -- gcc_target_compile substitutes GCC_UNDER_TEST -- but it
# is what build_wrapper compiles DejaGnu's testglue.c with, so it has to work.
#
# find_gcc alone does not.  It looks for an xgcc under tool_root_dir and, when
# there is no gcc build tree because an *installed* cross compiler is under
# test, falls back to [transform gcc].  With no target_alias set that yields a
# bare "-gcc", build_wrapper's target_compile fails, and build_wrapper returns
# an empty string without saying anything -- so no glue is linked, no status
# marker is printed, and every execution test reports 2.  Prefer the compiler
# actually under test, which is the normal case for this board.
if { [info exists ::GCC_UNDER_TEST] } {
    set_board_info compiler "$::GCC_UNDER_TEST"
} else {
    set_board_info compiler "[find_gcc]"
}

# No -ffreestanding.  Under it GCC drops the C99 implicit "return 0" on
# falling off the end of main, which most execute tests do, and they then
# return their last computed value and look like failures.
set_board_info cflags ""

# Startup and runtime must be prebuilt objects, not sources: DejaGnu wraps
# every ldflags entry in -Wl,, so a .c or .S here would be handed to the linker
# rather than the compiler.  Run ./build-support.sh once.
#
# -lc is RTEMS's own newlib, which is the point -- the tests then exercise the
# C library RTEMS actually ships.  obj/*/runtime.o supplies the three things
# that newlib expects RTEMS to provide and bare metal does not: the reentrancy
# pointer, the mutex primitives its stdio locks against, and malloc.
set mb_endian "be"
if { [string match "*-mlittle-endian*" [board_info_field_or_empty target multilib_flags]] } {
    set mb_endian "le"
}
set mb_obj "$mb_dir/obj/$mb_endian"
if { ![file exists "$mb_obj/crt0.o"] } {
    error "mb-qemu: $mb_obj/crt0.o is missing -- run $mb_dir/build-support.sh first"
}
# Which libraries to link is decided by build-support.sh, because it depends
# on whether the toolchain has a C library at all.
set mb_libs "-lc -lgcc"
if { [file exists "$mb_obj/config.sh"] } {
    set fh [open "$mb_obj/config.sh" r]
    set cfg [read $fh]
    close $fh
    if { [regexp {MB_LIBS="([^"]*)"} $cfg -> m] } { set mb_libs $m }
    if { [regexp {MB_CFLAGS="([^"]*)"} $cfg -> m] } { set_board_info cflags $m }
    # Set when the toolchain's linker mis-adjusts wrapped symbols while
    # relaxing, which breaks DejaGnu's status wrapper.  See the probe in
    # build-support.sh and ../../patches/binutils/0013-*.patch.
    if { [regexp {MB_LDEXTRA_BOARD="([^"]*)"} $cfg -> m] } { set mb_ldboard $m }
}
if { ![info exists mb_ldboard] } { set mb_ldboard "" }

# MB_LDEXTRA carries anything the toolchain needs to find its own libraries --
# -L into an uninstalled build tree, typically.
set mb_ldextra ""
if { [info exists env(MB_LDEXTRA)] } { set mb_ldextra $env(MB_LDEXTRA) }

# MB_MODDI3 links a replacement __moddi3 ahead of libgcc so it wins, which is
# how a candidate fix is tested against the suite.
set mb_moddi3 ""
if { [info exists env(MB_MODDI3)] } { set mb_moddi3 $env(MB_MODDI3) }

# -L$mb_obj is where build-support.sh puts the empty libc.a/libm.a it creates
# for a toolchain with no C library; harmless otherwise.
set_board_info ldflags \
    "-nostartfiles -T$mb_dir/mb-qemu.ld $mb_obj/crt0.o $mb_moddi3 \
     $mb_obj/runtime.o -L$mb_obj $mb_ldextra $mb_libs $mb_ldboard"

# Bare metal: no OS services.  Saying so gets tests marked UNSUPPORTED rather
# than failed.
set_board_info noargs 1
set_board_info gdb,nosignals 1
set_board_info gdb,noinferiorio 1
set_board_info gdb,no_hardware_watchpoints 1
# 1, not 0.  remote.exp's check_for_board_status tests this with `ne ""`, and
# targetdb.exp hands back the stored string, so a literal 0 reads as "set" and
# makes a missing marker mean status 2 -- which is how this board used to
# report 2 for every run.  gcc.exp guards against "0" (gcc.exp:164-166),
# remote.exp does not.  mn10300-sim.exp uses "" when it wants this off.
set_board_info needs_status_wrapper 1

# No sim_load override.  There used to be one here, blaming generic sim_load
# for "spawning on target and waiting on host" and so losing the exit status.
# That diagnosis was wrong: config/sim.exp spawns and waits on the same leg and
# recovers the status correctly, then overwrites it with check_for_board_status
# -- which returned 2 because needs_status_wrapper was set to a literal 0.
# With that fixed the generic code works, so the override is gone.
